.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# The plug era's outlet dataset, training runs and detector weights (its code
# went in #376): still ignored so an older checkout's local copies stay out.
datasets/
runs/
yolo*.pt

# Feature-probe records (scripts/experiment.py --probe, issue #264): a gate
# reports into the issue it informs, never into results/
probes/

# Demo footage — derived, and far too big to keep every version of forever
# (one GIF is ~6 MB against a 7 MB repo history). Regenerate with:
#   MUJOCO_GL=egl uv run python scripts/draw.py --record draw.mp4 --record-speed 3
#   MUJOCO_GL=egl uv run python scripts/pickup.py --record pickup.gif --record-speed 4
# To embed one in the README, drag it into a GitHub issue comment and use the
# CDN URL GitHub hands back — it renders inline at zero cost to the repo.
*.mp4
*.gif

# Local secrets: the ingest token, DB password, session secret. NEVER commit
# these -- this repo is intended to be open-sourced, and an untracked .env is
# one `git add -A` away from being public forever.
.env
.env.*
!.env-example
