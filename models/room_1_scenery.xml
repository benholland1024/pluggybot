<!-- room_1 SCENERY: the floor plan behind room_hub.xml -- walls, obstacles,
     and the plug era's outlets, decoys and socket include, kept as scenery
     until the rover's worlds go (#376 stage C). -->
<mujocoinclude>
  <worldbody>

    <!--  Map (y+ is north, x+ is east)

      ########################################
      #                  #                   #
      #                  #                   #
      #      ###                             #
      #      ###                             #
      #                  #                   #
      #                  #       #####       #
      #                  #       #####       #
      #       x          #          ##       #
      #                  #          ##       #
      #               ####                   #
      #               ####                   #
      ########################################

      Walls:
       - North
       - East
       - South
       - West
       - Divider top
       - Divider bottom
      Room 1:
       - Corner box
       - Floor box
      Room 2:
        - L box north
        - L box side
    
    -->

    <!-- Light the whole area -->
    <light dir="0 0 -1" directional="true"/>
    

    <!--  Walls  -->
    
    <!-- Wall north (red)  -->
    <body name="wall-north" pos="2.0 6.0 0.6">
      <geom type="box" size="4.0 0.01 0.6" rgba="0.8 0.2 0.2 1"/>
    </body>

    <!-- Wall east (green) -->
    <body name="wall-east" pos="6.0 2.0 0.6">
      <geom type="box" size="0.01 4.0 0.6" rgba="0.2 0.8 0.2 1"/>
    </body>

    <!-- Wall south (blue)  -->
    <body name="wall-south" pos="2.0 -2.0 0.6">
      <geom type="box" size="4.0 0.01 0.6" rgba="0.2 0.2 0.8 1"/>
    </body>

    <!-- Wall west (yellow) -->
    <body name="wall-west" pos="-2.0 2.0 0.6">
      <geom type="box" size="0.01 4.0 0.6" rgba="0.8 0.8 0.2 1"/>
    </body>

    <!-- Wall divider top (purple) -->
    <body name="wall-divider-top" pos="2.0 5.0 0.6">
      <geom type="box" size="0.01 1.0 0.6" rgba="0.8 0.2 0.8 1"/>
    </body>

    <!-- Wall divider bottom (cyan) -->
    <body name="wall-divider-bottom" pos="2.0 0.0 0.6">
      <geom type="box" size="0.01 2.0 0.6" rgba="0.2 0.8 0.8 1"/>
    </body>

    <!--  Obstacles  -->
 
    <!-- Corner box (black) -->
    <body name="corner-box" pos="1.5 -1.5 0.15">
      <geom type="box" size="0.5 0.5 0.15" rgba="0.1 0.1 0.1 1"/>
    </body>

    <!-- Floor box (white) -->
    <body name="floor-box" pos="0.0 4 0.15">
      <geom type="box" size="0.5 0.5 0.15" rgba="0.9 0.9 0.9 1"/>
    </body>

    <!-- L box north (light red) -->
    <body name="L-box-north" pos="4.0 1 0.15">
      <geom type="box" size="0.5 0.25 0.15" rgba="0.9 0.5 0.5 1"/>
    </body>

    <!-- L box side (light green) -->
    <body name="L-box-side" pos="4.25 0.5 0.15">
      <geom type="box" size="0.25 0.25 0.15" rgba="0.5 0.9 0.5 1"/>
    </body>

    <!-- Dockable sockets: invisible collision geometry aligned with the
         visual outlets below (generated file — see header). -->
    <include file="schuko_sockets.xml"/>

    <!--  Outlets (Schuko, from primitives): the plug era's detector targets,
          scenery now. Visual layer only (contype 0) — the matching
          COLLISION layer is the invisible surface-mount sockets in
          schuko_sockets.xml. Heights 0.26 / 0.30 / 0.38 m.
    -->

    <!-- Outlet A: west wall, room 1. Bright white, slightly oversized plate. -->
    <body name="outlet_a" pos="-1.953 1.0 0.26" euler="0 0 0">
      <geom name="outlet_a_housing" type="box" size="0.0165 0.048 0.048"
            pos="-0.0205 0 0" rgba="0.91 0.90 0.87 1" contype="0" conaffinity="0"/>
      <geom name="outlet_a_plate" type="box" size="0.004 0.042 0.042"
            rgba="0.97 0.96 0.94 1" contype="0" conaffinity="0"/>
      <geom name="outlet_a_well" type="cylinder" size="0.028 0.0015" zaxis="1 0 0"
            pos="0.0045 0 0" rgba="0.78 0.77 0.74 1" contype="0" conaffinity="0"/>
      <geom name="outlet_a_wellfloor" type="cylinder" size="0.024 0.0015" zaxis="1 0 0"
            pos="0.0058 0 0" rgba="0.90 0.89 0.86 1" contype="0" conaffinity="0"/>
      <geom name="outlet_a_hole_l" type="cylinder" size="0.0024 0.0015" zaxis="1 0 0"
            pos="0.0068 0.0095 0" rgba="0.08 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom name="outlet_a_hole_r" type="cylinder" size="0.0024 0.0015" zaxis="1 0 0"
            pos="0.0068 -0.0095 0" rgba="0.08 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom name="outlet_a_clip_top" type="box" size="0.0018 0.005 0.0015"
            pos="0.0062 0 0.024" rgba="0.60 0.61 0.63 1" contype="0" conaffinity="0"/>
      <geom name="outlet_a_clip_bot" type="box" size="0.0018 0.005 0.0015"
            pos="0.0062 0 -0.024" rgba="0.60 0.61 0.63 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Outlet B: south wall, room 1. Warm cream, slightly undersized plate. -->
    <body name="outlet_b" pos="0.5 -1.953 0.30" euler="0 0 90">
      <geom name="outlet_b_housing" type="box" size="0.0165 0.048 0.048"
            pos="-0.0205 0 0" rgba="0.91 0.90 0.87 1" contype="0" conaffinity="0"/>
      <geom name="outlet_b_plate" type="box" size="0.004 0.038 0.038"
            rgba="0.89 0.86 0.79 1" contype="0" conaffinity="0"/>
      <geom name="outlet_b_well" type="cylinder" size="0.028 0.0015" zaxis="1 0 0"
            pos="0.0045 0 0" rgba="0.70 0.68 0.62 1" contype="0" conaffinity="0"/>
      <geom name="outlet_b_wellfloor" type="cylinder" size="0.024 0.0015" zaxis="1 0 0"
            pos="0.0058 0 0" rgba="0.83 0.81 0.75 1" contype="0" conaffinity="0"/>
      <geom name="outlet_b_hole_l" type="cylinder" size="0.0024 0.0015" zaxis="1 0 0"
            pos="0.0068 0.0095 0" rgba="0.08 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom name="outlet_b_hole_r" type="cylinder" size="0.0024 0.0015" zaxis="1 0 0"
            pos="0.0068 -0.0095 0" rgba="0.08 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom name="outlet_b_clip_top" type="box" size="0.0018 0.005 0.0015"
            pos="0.0062 0 0.022" rgba="0.64 0.65 0.66 1" contype="0" conaffinity="0"/>
      <geom name="outlet_b_clip_bot" type="box" size="0.0018 0.005 0.0015"
            pos="0.0062 0 -0.022" rgba="0.64 0.65 0.66 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Outlet C: east wall, room 2. Cool light gray, standard plate. -->
    <body name="outlet_c" pos="5.953 4.5 0.38" euler="0 0 180">
      <geom name="outlet_c_housing" type="box" size="0.0165 0.048 0.048"
            pos="-0.0205 0 0" rgba="0.91 0.90 0.87 1" contype="0" conaffinity="0"/>
      <geom name="outlet_c_plate" type="box" size="0.004 0.04 0.04"
            rgba="0.84 0.85 0.86 1" contype="0" conaffinity="0"/>
      <geom name="outlet_c_well" type="cylinder" size="0.028 0.0015" zaxis="1 0 0"
            pos="0.0045 0 0" rgba="0.66 0.67 0.69 1" contype="0" conaffinity="0"/>
      <geom name="outlet_c_wellfloor" type="cylinder" size="0.024 0.0015" zaxis="1 0 0"
            pos="0.0058 0 0" rgba="0.78 0.79 0.80 1" contype="0" conaffinity="0"/>
      <geom name="outlet_c_hole_l" type="cylinder" size="0.0024 0.0015" zaxis="1 0 0"
            pos="0.0068 0.0095 0" rgba="0.08 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom name="outlet_c_hole_r" type="cylinder" size="0.0024 0.0015" zaxis="1 0 0"
            pos="0.0068 -0.0095 0" rgba="0.08 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom name="outlet_c_clip_top" type="box" size="0.0018 0.005 0.0015"
            pos="0.0062 0 0.024" rgba="0.58 0.59 0.61 1" contype="0" conaffinity="0"/>
      <geom name="outlet_c_clip_bot" type="box" size="0.0018 0.005 0.0015"
            pos="0.0062 0 -0.024" rgba="0.58 0.59 0.61 1" contype="0" conaffinity="0"/>
    </body>

    <!--  Wall decoys: the plug era's hard negatives for its outlet
          detector, scenery now.  -->

    <!-- Light switch: west wall, room 1 (plate + rocker) -->
    <body name="decoy_switch_w" pos="-1.986 3.0 0.34" euler="0 0 0">
      <geom name="decoy_switch_w_plate" type="box" size="0.004 0.04 0.04"
            rgba="0.92 0.91 0.88 1" contype="0" conaffinity="0"/>
      <geom name="decoy_switch_w_rocker" type="box" size="0.004 0.018 0.026"
            pos="0.004 0 0" rgba="0.92 0.91 0.88 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Blank plate: south wall, room 2 -->
    <body name="decoy_blank_s" pos="4.5 -1.986 0.28" euler="0 0 90">
      <geom name="decoy_blank_s_plate" type="box" size="0.004 0.04 0.04"
            rgba="0.88 0.88 0.90 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Pictures: north wall room 1, east wall room 2 -->
    <body name="decoy_pic_n" pos="0.5 5.988 0.42" euler="0 0 270">
      <geom name="decoy_pic_n_canvas" type="box" size="0.002 0.10 0.06"
            rgba="0.35 0.48 0.72 1" contype="0" conaffinity="0"/>
    </body>
    <body name="decoy_pic_e" pos="5.988 1.0 0.36" euler="0 0 180">
      <geom name="decoy_pic_e_canvas" type="box" size="0.002 0.14 0.08"
            rgba="0.62 0.33 0.30 1" contype="0" conaffinity="0"/>
    </body>

  </worldbody>
</mujocoinclude>
