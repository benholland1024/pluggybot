<mujoco>
  <!-- world.xml's sibling for the HUB ERA: same bare world (floor + light),
       but carrying the FORK robot (pluggybot_fork.xml) instead of the plug
       robot. room_hub.xml builds on this the way room_1.xml builds on
       world.xml. -->
  <option integrator="implicitfast"/>

  <include file="pluggybot_fork.xml" />

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.5 0.5 0.5 1"/>
  </worldbody>
</mujoco>
