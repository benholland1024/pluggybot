<mujocoinclude>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality offsamples="0"/>
    <!-- offsamples="0": the robot's cameras are MEASUREMENT devices (issue #110).
       With MSAA on, the same static scene renders to a different image every
       time (+-1 in a few dozen shadow-edge pixels), the AprilTag decode moves on
       ~0.6 % of looks, and five identical scripted days gave three trajectories.
       Off, every render is byte-identical and the detector sees the same tags at
       every range. SimNotes, "The world was not the same world twice". -->
  </visual>

  <worldbody>

    

    <!-- origin at axle height (aka wheel radius) -->
    <body name="pluggybot" pos="0 0 0.045">
      <freejoint />

      <!-- For the gyroscope  -->
      <site name="imu" pos="0 0 0.05"/> 
      
      <geom
        name="chassis"
        type="box"
        size="0.12 0.09 0.03"
        pos="0 0 0.045"
        mass="0.9"
        rgba="0.2 0.4 0.8 1"
      />

      <!-- Battery (placeholder mass/size: ~5000 mAh 3S LiPo class, Parts.md).
           Position is deliberate, not packaging: slightly AHEAD of centre
           (x=+0.05) and low. Measured (SimNotes): over the axle it buys
           traction but no tipping margin; here it buys both. y=+0.06 is a
           counterweight: the arm assembly hangs at y=-0.05, and without the
           offset the robot veered 26 cm right over 4 m of open-loop driving. -->
      <geom
        name="battery"
        type="box"
        size="0.065 0.023 0.013"
        pos="0.05 0.06 0.092"
        mass="0.40"
        rgba="0.15 0.15 0.2 1"
      />

      <!--  Head  -->
      <body name="head" pos="-0.08 0 0.135">
        <geom
          name="head_mount"
          type="box"
          size="0.02 0.02 0.02"
          pos="0 0 0"
          mass="0.12"
          rgba="0.2 0.4 0.8 1"
        />

        <!--  Cameras  -->
        <!--  Decoding xyaxes="0 -1 0  0 0 1": 
                image-right is body −y, image-up is body +z, 
                which forces the viewing direction to be body +x
        -->
        <camera name="left_eye" pos="0.03 0.03 0" xyaxes="0 -1 0 0 0 1" fovy="41"/>
        <camera name="right_eye" pos="0.03 -0.03 0" xyaxes="0 -1 0 0 0 1" fovy="41"/>

      </body>


      <body name="left_wheel" pos="-0.08 0.105 0">
        <joint
          name="left_wheel_joint"
          type="hinge"
          axis="0 1 0"
          armature="0.012"
          damping="0.05"
        />
        <geom
          type="cylinder"
          size="0.045 0.005"
          zaxis="0 1 0"
          mass="0.05"
          rgba="0.1 0.1 0.1 1"
        />
        <!-- Spoke - purely visual, to see rotation  -->
        <geom
          type="box"
          size="0.04 0.013 0.004"
          mass="0.001"
          contype="0"
          conaffinity="0"
          rgba="1 1 0.3 1"
        />
      </body>

      <body name="right_wheel" pos="-0.08 -0.105 0">
        <joint
          name="right_wheel_joint"
          type="hinge"
          axis="0 1 0"
          armature="0.012"
          damping="0.05"
        />
        <geom
          type="cylinder"
          size="0.045 0.005"
          zaxis="0 1 0"
          mass="0.05"
          rgba="0.1 0.1 0.1 1"
        />
        <!-- Spoke - purely visual, to see rotation  -->
        <geom
          type="box"
          size="0.04 0.013 0.004"
          mass="0.001"
          contype="0"
          conaffinity="0"
          rgba="1 1 0.3 1"
        />
      </body>

      <!-- caster:
        center height is radius at rest,
        so z = caster_radius − wheel_radius = 0.02 − 0.045 = −0.025

        condim="1" makes it frictionless (while retaining normal force)
        priority="1" makes it so the frictionless is the priority over the floor's friction
      -->
      <geom
        name="caster"
        type="sphere"
        size="0.02"
        pos="0.10 0 -0.025"
        mass="0.02"
        condim="1"
        priority="1"
      />

      <!-- ======================= Docking arm (milestone 6) =================
           Stretch-style decomposition: base owns x/yaw, LIFT owns z, ARM owns
           reach. Offset to the RIGHT (y=-0.05) so the arm plane clears the
           head cameras (mapping bakes in their fixed offsets — they must not
           move). Masses are placeholders pending the igus quote (Parts.md);
           marked TBD where so.
      -->

      <!-- Mast: fixed column + lift motor block at its foot (igus NEMA11
           lead-screw class). Column top at body-local z=0.455. TBD masses. -->
      <geom name="mast" type="box" size="0.015 0.015 0.19"
            pos="-0.10 -0.05 0.265" mass="0.20" rgba="0.55 0.57 0.6 1"/>
      <geom name="lift_motor" type="box" size="0.015 0.02 0.02"
            pos="-0.105 -0.05 0.095" mass="0.15" rgba="0.3 0.3 0.32 1"/>

      <!-- Carriage: rides the mast. Body origin sits ON the plug axis, so
           lift_joint qpos 0 parks the plug axis at world z=0.145 — below the
           scanner's z=0.18 center row, so the parked arm cannot corrupt the
           map. Range 0.31 puts the plug axis at 0.455 max: covers room_1's
           highest outlet (0.38) with margin. Carriage mass includes the
           arm-drive motor (TBD). -->
      <body name="carriage" pos="-0.10 -0.05 0.10">
        <joint name="lift_joint" type="slide" axis="0 0 1" range="0 0.31"
               damping="10"/>
        <geom name="carriage_block" type="box" size="0.025 0.02 0.022"
              pos="0.01 0 0.008" mass="0.25" rgba="0.4 0.42 0.45 1"/>

        <!-- Alignment feelers: straddle the socket at lateral ±0.085. The
             earlier ±0.07 straddle cleared the ±0.042 VISUAL plate but not
             the ±0.055 COLLISION housing of the surface-mount socket: with
             >7 mm of lateral error a prong tip landed on the housing edge
             39 mm proud of the wall (measured in the RL dock env), wrecking
             both the yaw squaring and the depth reference. ±0.085 keeps
             22 mm of margin. Both tips touching the wall squares the
             robot's yaw mechanically (two-point contact across a 0.17 m
             base) and references insertion depth. They are NOT an anti-tip
             brace — that idea was measured false: a wall contact is
             one-way, so it can only push the robot AWAY from the wall, adding
             to the insertion reaction instead of resisting it (SimNotes).
             Tips at body-local x=+0.16 — 4 cm past the bumper, so the mapping
             reflex (stops with the wall at body +0.20) still protects them.
             Mounted 2 cm ABOVE the plug axis (a standoff bracket on the
             carriage): at ±0.085 and axis height the left prong swept
             through the battery's corner at low lift — caught by the
             geometric clearance test, invisible to contacts as always. -->
        <geom name="prong_l" type="box" size="0.10 0.008 0.008"
              pos="0.16 0.085 0.02" mass="0.01" friction="1.5" rgba="0.25 0.25 0.28 1"/>
        <geom name="prong_r" type="box" size="0.10 0.008 0.008"
              pos="0.16 -0.085 0.02" mass="0.01" friction="1.5" rgba="0.25 0.25 0.28 1"/>

        <!-- Docking camera: rises with the plug, mounted above it so the plug
             body doesn't occlude the socket until the last moment. The head
             pair stays fixed for mapping; this one exists because the fixed
             eye loses a 0.38 m outlet inside 0.40 m range (measured). -->
        <camera name="dock_eye" pos="0.03 0 0.06" xyaxes="0 -1 0 0 0 1" fovy="41"/>

        <!-- Telescoping arm: short tube, 0.20 m stroke. Retracted, the plug
             tip sits at body-local +0.059 — safely behind the +0.12 bumper. -->
        <body name="arm" pos="0 0 0">
          <joint name="arm_joint" type="slide" axis="1 0 0" range="0 0.20"
                 damping="5"/>
          <geom name="arm_tube" type="box" size="0.06 0.012 0.012"
                pos="0.08 0 0" mass="0.12" rgba="0.5 0.52 0.55 1"/>

          <!-- Plug on a passive compliant wrist (RCC, Parts.md): sprung
               slides/hinges let contact forces self-centre the plug instead
               of jamming. Stiffnesses copied from the schuko spike carrier —
               placeholder until a real spring pack is measured. Geometry
               matches docking/schuko.py (35.5 mm body — open decision 8:
               real rewireable plugs may be 36.7 mm). Collision ENABLED:
               this is the geom that docks. -->
          <body name="plug" pos="0.14 0 0">
            <joint name="plug_lat_y" type="slide" axis="0 1 0" range="-0.02 0.02"
                   stiffness="150" damping="4" armature="1e-5"/>
            <joint name="plug_lat_z" type="slide" axis="0 0 1" range="-0.02 0.02"
                   stiffness="150" damping="4" armature="1e-5"/>
            <joint name="plug_rot_z" type="hinge" axis="0 0 1" range="-0.35 0.35"
                   stiffness="1.0" damping="0.05" armature="1e-5"/>
            <joint name="plug_rot_y" type="hinge" axis="0 1 0" range="-0.35 0.35"
                   stiffness="1.0" damping="0.05" armature="1e-5"/>
            <geom name="plug_body" type="cylinder" size="0.01775 0.020"
                  zaxis="1 0 0" pos="0.02 0 0" mass="0.05" rgba="0.15 0.25 0.6 1"/>
            <geom name="plug_pin_l" type="capsule" size="0.0024"
                  fromto="0.0424 0.0095 0 0.0566 0.0095 0" mass="0.003"
                  rgba="0.75 0.75 0.78 1"/>
            <geom name="plug_pin_r" type="capsule" size="0.0024"
                  fromto="0.0424 -0.0095 0 0.0566 -0.0095 0" mass="0.003"
                  rgba="0.75 0.75 0.78 1"/>
            <site name="plug_face" pos="0.04 0 0" size="0.002"/>
            <site name="plug_tip" pos="0.059 0 0" size="0.002"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- The arm tube passes beside the mast on a carriage bracket in the real
       igus unit; as primitives on one axis they would interpenetrate. -->
  <contact>
    <exclude body1="pluggybot" body2="arm"/>
  </contact>

  <actuator>
    <velocity
      name="left_motor"
      joint="left_wheel_joint"
      kv="0.5"
      ctrlrange="-21 21"
      forcerange="-2.06 2.06"
    />
    <velocity
      name="right_motor"
      joint="right_wheel_joint"
      kv="0.5"
      ctrlrange="-21 21"
      forcerange="-2.06 2.06"
    />
    <!-- Lift + arm: position servos (a stepper lead-screw IS a position
         device). forcerange from the igus DLE-LA-0001 spec: 50 N thrust.
         ctrl is the joint target in meters. -->
    <position
      name="lift"
      joint="lift_joint"
      kp="1200"
      kv="60"
      ctrlrange="0 0.31"
      forcerange="-50 50"
    />
    <position
      name="arm"
      joint="arm_joint"
      kp="1200"
      kv="60"
      ctrlrange="0 0.20"
      forcerange="-50 50"
    />
  </actuator>

  <sensor>
    <gyro name="imu_gyro" site="imu"/>
  </sensor>

</mujocoinclude>