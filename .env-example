# PluggyBot environment — copy to `.env` and fill in.
#
# ⚠ NOTHING IN THIS REPO LOADS THIS FILE. There is no python-dotenv; the sim
# reads the process environment. So `.env` is for you and for Docker:
#
#   set -a; . ./.env; set +a          # a shell session
#   docker run --env-file .env ...    # the serving image
#
# The website (rooftop-media-2026) has its own .env with its own secrets --
# SESSION_SECRET and POSTGRES_PASSWORD belong there, not here.
#
# `.env` is gitignored; this example is not. Never put a real value below.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Ingest secret the sim presents to /api/pluggyworld/ingest. Must match the
# website's PLUGGYWORLD_TOKEN. Read by serve.py directly rather than turned
# into a flag, so it never appears in `ps`.
PLUGGYWORLD_TOKEN=

# Whichever backend the overseer uses reads its own key from the environment;
# serve.py never sees them. Only the one you actually use needs a value.
ANTHROPIC_API_KEY=      # backend `anthropic` (via the SDK)
HF_TOKEN=               # backend `huggingface` — the Inference Providers router
PLUGGY_OVERSEER_KEY=    # backend `openai-compatible` — somebody else's endpoint

# ── Rendering ────────────────────────────────────────────────────────────────
# `egl` needs a GPU; `osmesa` is software and what the serving image bakes in.
# Do NOT set this for a `--view` run — the viewer wants the default.
MUJOCO_GL=egl

# ── The run (read by deploy/entrypoint.sh, turned into serve.py flags) ───────
PLUGGY_ENDPOINT=ws://localhost:3000/api/pluggyworld/ingest
PLUGGY_WORLD=home           # home | room_hub
PLUGGY_ERRAND=draw          # carry | draw | census | dance | showcase | none
PLUGGY_RATE=1.0             # sim seconds per wall second
PLUGGY_MAX_SIM_TIME=3600
PLUGGY_ROBOT_NAME=          # this instance's identity; `pluggybot` is the species
PLUGGY_PACK=                # `hosting` for the hours-long cell a watched world wants
PLUGGY_BATTERY_WH=          # a raw number; overrides PLUGGY_PACK
PLUGGY_RESERVE_WH=          # the return-trip margin — a property of the floor plan

# ── World state (a volume in deployment; each path IMPLIES its feature) ──────
PLUGGY_BOARDS=              # whiteboard ink, so a restart keeps what was drawn
PLUGGY_LEDGER=              # the points ledger
PLUGGY_TASKS=               # job offers — a path turns the task board on
PLUGGY_THOUGHTS=            # the four memory documents (issue #38)
PLUGGY_GOALS=               # long-term goals, as prose. Human-edited
PLUGGY_JOURNAL=             # notes-to-self. Only forwarded when the overseer is on
PLUGGY_METABOLISM=          # points-as-food; UNSET means the robot never gets hungry

# ── Tuning data (mount a file, no rebuild) ───────────────────────────────────
PLUGGY_REWARDS=             # what a job pays
PLUGGY_CADENCE=             # how busy the world is
PLUGGY_QUESTIONS=           # the question bank
PLUGGY_ENERGY=              # what an errand costs

# ── The mind (issue #15/#19) ─────────────────────────────────────────────────
# ⚠ UNSET MEANS NO OVERSEER, and a world with no overseer advertises only the
# inbound kinds CODE handles — so visitor suggestions and questions are held
# rather than delivered. Set this to "1" if you want the chat channel live.
PLUGGY_OVERSEER=
PLUGGY_MODEL=               # `org/name` → HuggingFace router; a bare id → Anthropic
PLUGGY_OVERSEER_BACKEND=    # auto | anthropic | huggingface | local | openai-compatible
PLUGGY_OVERSEER_URL=        # `local` (ollama) or an openai-compatible endpoint
PLUGGY_OVERSEER_BUDGET=     # calls per rolling hour; defaults to the built-in cap

# ── Money and the operator's switch (issue #37) ──────────────────────────────
# ⚠ Both files belong on the state volume: a budget that reset on restart
# would be no budget, and a robot paused before a restart must come back paused.
PLUGGY_WEEKLY_USD=          # the soft weekly cap. The account balance is the hard one
PLUGGY_SPEND=               # spend.json
PLUGGY_MODE_FILE=           # mode.json — llm | scripted | paused
PLUGGY_ESCALATE_TO=         # the model a "think harder" decision escalates to
